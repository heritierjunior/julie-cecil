<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title }} | {{ site.title }}</title>
  <meta name="description" content="{{ site.tagline }}">
  <link rel="stylesheet" href="{{ 'css/custom.css' | url }}">
</head>
<body>
  <header>
    <nav aria-label="Navigation principale">
      <a href="{{ '' | url }}" class="logo"><span class="logo-mark">IJ</span><span>IR JULIE <b>& Homestore</b></span></a>
      <ul>
        <li><a href="{{ '' | url }}">Accueil</a></li>
        <li><a href="#portfolio">Portfolio</a></li>
        <li><a href="#boutique">Boutique</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="hero">
      <div class="hero-content">
        <span class="eyebrow">Portfolio & boutique tech</span>
        <h1>Concevez un espace de travail qui performe.</h1>
        <p>{{ site.tagline }}. L'expertise d'IR JULIE rencontre une sélection premium pensée pour vos projets.</p>
        <div class="hero-actions">
          <a href="{{ 'portfolio/' | url }}" class="btn btn-primary">Découvrir mon expertise</a>
          <a href="{{ 'homestore/' | url }}" class="btn btn-light">Voir la boutique</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="Services proposés">
        <div><strong>500+</strong><span>postes accompagnés</span></div>
        <div><strong>Apple × Windows</strong><span>architectures hybrides</span></div>
        <div><strong>Sur mesure</strong><span>conseil & équipements</span></div>
      </div>
    </div>

    <section class="intro-section">
      <div class="section-heading">
        <span class="eyebrow dark">Une expertise, deux solutions</span>
        <h2>Moins de friction. Plus de performance.</h2>
      </div>
      <p>Du diagnostic à l'installation, IR JULIE accompagne les particuliers et les organisations dans leurs choix numériques. Homestore complète cette expertise avec du matériel fiable et des équipements de bureau soigneusement sélectionnés.</p>
    </section>

    <div class="duo-grid">
      <article id="portfolio" class="feature-card feature-portfolio">
        <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=1200&auto=format&fit=crop&q=85" alt="Conseil stratégique et travail collaboratif">
        <div class="feature-content">
          <span class="badge">Expertise</span>
          <h3>Votre conseillère systèmes & infrastructure</h3>
          <p>Architecture hybride, cybersécurité, optimisation des parcs et pilotage de projets de transformation digitale.</p>
          <a href="mailto:contact@irjulie.com" class="text-link">Demander une expertise <span>&rarr;</span></a>
        </div>
      </article>
      <article id="boutique" class="feature-card feature-shop">
        <img src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?w=1200&auto=format&fit=crop&q=85" alt="Espace de travail moderne">
        <div class="feature-content">
          <span class="badge badge-green">Boutique</span>
          <h3>Votre équipement, pensé pour durer</h3>
          <p>Stations de travail, ordinateurs Apple et Windows, bureaux ergonomiques et périphériques professionnels.</p>
          <a href="#catalogue" class="text-link">Voir la sélection <span>&rarr;</span></a>
        </div>
      </article>
    </div>

    <section id="catalogue" class="catalogue-section">
      <div class="section-heading split-heading">
        <div>
          <span class="eyebrow dark">Sélection du moment</span>
          <h2>Équipements essentiels</h2>
        </div>
        <a href="mailto:shop@homestore.com?subject=Demande%20du%20catalogue" class="text-link">Demander le catalogue <span>&rarr;</span></a>
      </div>

      <div class="grid-products">
        <div class="card-product">
          <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800&auto=format&fit=crop&q=80" alt="Apple MacBook Pro">
          <div class="card-body">
            <span class="badge">Apple Mac</span>
            <h3>MacBook Pro 16"</h3>
            <p>Puce M3 Max, écran Liquid Retina XDR et performances adaptées aux flux créatifs exigeants.</p>
            <div class="price">3 499,00 €</div>
            <a href="mailto:shop@homestore.com?subject=Commande%20MacBook%20Pro" class="btn btn-small">Demander</a>
          </div>
        </div>

        <div class="card-product">
          <img src="https://images.unsplash.com/photo-1593642632823-8f785ba67e45?w=800&auto=format&fit=crop&q=80" alt="PC Windows Workstation">
          <div class="card-body">
            <span class="badge badge-blue">Windows Pro</span>
            <h3>Station Windows Pro</h3>
            <p>Intel Core i9 et NVIDIA RTX pour le développement, l'ingénierie et la création 3D.</p>
            <div class="price">2 890,00 €</div>
            <a href="mailto:shop@homestore.com?subject=Commande%20Station%20Windows" class="btn btn-small">Demander</a>
          </div>
        </div>

        <div class="card-product">
          <img src="https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?w=800&auto=format&fit=crop&q=80" alt="Bureau ergonomique moderne">
          <div class="card-body">
            <span class="badge badge-green">Workspace</span>
            <h3>Bureau assis-debout</h3>
            <p>Structure robuste, plateau bois naturel et réglage motorisé pour un confort durable.</p>
            <div class="price">690,00 €</div>
            <a href="mailto:shop@homestore.com?subject=Commande%20Bureau" class="btn btn-small">Demander</a>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div>
        <span class="eyebrow">Un projet en tête ?</span>
        <h2>Construisons ensemble votre environnement idéal.</h2>
      </div>
      <a href="mailto:contact@irjulie.com" class="btn btn-light">Prendre rendez-vous</a>
    </section>
  </main>

  <footer>
    <p>&copy; 2026 IR JULIE & Homestore. Tous droits réservés. Propulsé par <a href="https://cecil.app">Cecil</a>.</p>
  </footer>
</body>
</html>
